# Copie ce fichier en .env.local et renseigne les valeurs publiques de ton projet Supabase.
# Ces deux valeurs sont PUBLIQUES (la sécurité repose sur les politiques RLS).
# Ne mets JAMAIS la service_role key ni aucun mot de passe SMTP ici.
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Optionnel : clé CARTO (fonds de carte Voyager / Clair / Sombre). Clé publique gratuite :
# https://carto.com/basemaps/apikey — sans elle, la carte utilise OpenStreetMap.
VITE_CARTO_API_KEY=

# Optionnel : notifications push. Clé VAPID PUBLIQUE uniquement (la privée va dans les secrets Supabase).
VITE_VAPID_PUBLIC_KEY=
